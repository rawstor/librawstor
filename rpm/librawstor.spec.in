Name: librawstor
Version: @PACKAGE_VERSION_SHORT@
Release: @RPM_RELEASE@
Summary: Rawstor client library

License: LGPL
URL: https://github.com/rawstor/librawstor
Source0: %{name}-@PACKAGE_VERSION@.tar.gz

BuildRequires: liburing-devel >= @LIBURING_MIN_VERSION@
BuildRequires: systemd-rpm-macros
Requires: liburing >= @LIBURING_MIN_VERSION@

%description
Rawstor client library.


%package devel
Summary: Development files for %{name}
Requires: %{name} = %{version}-%{release}
Requires: pkgconfig

%description devel
Development files for %{name}.


%package -n rawstor-ost
Summary: Rawstor OST backend
Requires(pre): shadow-utils
Requires: %{name} = %{version}-%{release}
%{?systemd_requires}

%description -n rawstor-ost
Rawstor OST backend.


%pre -n rawstor-ost
getent group rawstor >/dev/null || groupadd -r rawstor
getent passwd rawstor >/dev/null || useradd -r -g rawstor -d /var/lib/rawstor -s /sbin/nologin -c "Rawstor OST daemon" rawstor


%package -n rawstor-vhost
Summary: Rawstor vhost-user-blk backend for QEMU
Requires(pre): shadow-utils
Requires: %{name} = %{version}-%{release}
%{?systemd_requires}

%description -n rawstor-vhost
Rawstor vhost-user-blk backend for QEMU.


%pre -n rawstor-vhost
getent group rawstor >/dev/null || groupadd -r rawstor
getent passwd rawstor >/dev/null || useradd -r -g rawstor -d /var/lib/rawstor -s /sbin/nologin -c "Rawstor daemon" rawstor

%post -n rawstor-vhost
if [ "$1" -gt 1 ]; then
    echo "rawstor-vhost upgraded: running rawstor-vhost@*.service instances are still using the previous binary."
    echo "Restart them to pick up the update, e.g.:"
    echo "  systemctl restart 'rawstor-vhost@*.service'"
fi


%package -n rawstor-vduse
Summary: Rawstor VDUSE virtio-blk backend
Requires(pre): shadow-utils
Requires: %{name} = %{version}-%{release}
%{?systemd_requires}

%description -n rawstor-vduse
Rawstor VDUSE (vDPA Device in Userspace) virtio-blk backend.


%pre -n rawstor-vduse
getent group rawstor >/dev/null || groupadd -r rawstor
getent passwd rawstor >/dev/null || useradd -r -g rawstor -d /var/lib/rawstor -s /sbin/nologin -c "Rawstor daemon" rawstor

%post -n rawstor-vduse
if [ -x /usr/bin/udevadm ]; then
    udevadm control --reload-rules || :
    udevadm trigger --subsystem-match=vduse || :
fi
if [ "$1" -gt 1 ]; then
    echo "rawstor-vduse upgraded: running rawstor-vduse@*.service instances are still using the previous binary."
    echo "Restart them to pick up the update, e.g.:"
    echo "  systemctl restart 'rawstor-vduse@*.service'"
fi

%prep
%autosetup -n %{name}-@PACKAGE_VERSION@

%build
%configure --disable-static --without-python3
make %{?_smp_mflags}

%install
rm -rf %{buildroot}
make install DESTDIR=%{buildroot} prefix=%{_prefix}
find %{buildroot} -name '*.la' -delete
ln -sf rawstor %{buildroot}%{_bindir}/rawstor-cli
mkdir -p %{buildroot}%{_unitdir}
install -m 644 systemd/rawstor-ost.service %{buildroot}%{_unitdir}/rawstor-ost.service
install -m 644 systemd/rawstor-vhost@.service %{buildroot}%{_unitdir}/rawstor-vhost@.service
install -m 644 systemd/rawstor-vduse@.service %{buildroot}%{_unitdir}/rawstor-vduse@.service
mkdir -p %{buildroot}/usr/lib/udev/rules.d
install -m 644 udev/60-rawstor-vduse.rules %{buildroot}/usr/lib/udev/rules.d/60-rawstor-vduse.rules
mkdir -p %{buildroot}/var/lib/rawstor

%post -n rawstor-ost
%systemd_post rawstor-ost.service

%preun -n rawstor-ost
%systemd_preun rawstor-ost.service

%postun -n rawstor-ost
%systemd_postun_with_restart rawstor-ost.service

%files
%{_bindir}/rawstor
%{_bindir}/rawstor-cli
%{_libdir}/librawstor.so.*
%doc COPYING ChangeLog.md README.md

%files devel
%{_includedir}/*
%{_libdir}/librawstor.so
%{_libdir}/pkgconfig/*.pc

%files -n rawstor-ost
%{_bindir}/rawstor-ost
%{_unitdir}/rawstor-ost.service
%dir %attr(0755, rawstor, rawstor) /var/lib/rawstor

%files -n rawstor-vhost
%{_bindir}/rawstor-vhost
%{_unitdir}/rawstor-vhost@.service

%files -n rawstor-vduse
%{_bindir}/rawstor-vduse
%{_unitdir}/rawstor-vduse@.service
/usr/lib/udev/rules.d/60-rawstor-vduse.rules
