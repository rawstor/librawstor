Name: librawstor
Version: @PACKAGE_VERSION_SHORT@
Release: @RPM_RELEASE@
Summary: Rawstor client library

License: LGPL
URL: https://github.com/rawstor/librawstor
Source0: %{name}-@PACKAGE_VERSION@.tar.gz

%{!?_unitdir: %global _unitdir /usr/lib/systemd/system}
%global python3_pkgversion 3.12
%global python3_version %{python3_pkgversion}
%global python3_sitelib %(RPM_BUILD_ROOT=/some/path && python3 -c "import sysconfig; print(sysconfig.get_path('platlib'))")

%description
Rawstor client library.


%package devel
Summary: Development files for %{name}
Requires: %{name} = %{version}-%{release}
Requires: pkgconfig

%description devel
Development files for %{name}.


%package -n rawstor-ost
Summary: Rawstor OST backend
Requires(pre): shadow-utils
Requires: %{name} = %{version}-%{release}

%description -n rawstor-ost
Rawstor OST backend.


%package -n python%{python3_pkgversion}-rawstor
Summary: Rawstor python bindings
Requires: python(abi) = %{python3_version}
Requires: %{name} = %{version}-%{release}

%description -n python%{python3_pkgversion}-rawstor
Rawstor python bindings.


%pre -n rawstor-ost
getent group rawstor >/dev/null || groupadd -r rawstor
getent passwd rawstor >/dev/null || useradd -r -g rawstor -d /var/lib/rawstor -s /sbin/nologin -c "Rawstor OST daemon" rawstor

%prep
%autosetup -n %{name}-@PACKAGE_VERSION@

%build
%configure --disable-static
make %{?_smp_mflags}

%install
rm -rf %{buildroot}
make install DESTDIR=%{buildroot} prefix=/usr
mkdir -p %{buildroot}%{_unitdir}
install -m 644 etc/systemd/system/rawstor-ost.service %{buildroot}%{_unitdir}/rawstor-ost.service
mkdir -p %{buildroot}/var/lib/rawstor

PYTHON_LIB=%{buildroot}%{python3_sitelib}
PYTHON_LOCAL=%{buildroot}/usr/local/lib/python%{python3_version}/dist-packages

echo PYTHON_LIB=%{buildroot}%{python3_sitelib}
echo PYTHON_LOCAL=%{buildroot}/usr/local/lib/python%{python3_version}/dist-packages

if [ -d "$PYTHON_LOCAL/rawstor" ]; then
    mkdir -p "$PYTHON_LIB"
    mv "$PYTHON_LOCAL/rawstor" "$PYTHON_LIB/"
    mv "$PYTHON_LOCAL/rawstor-"*.dist-info "$PYTHON_LIB/"
    rm -rf %{buildroot}/usr/local
fi

%post -n rawstor-ost
chown rawstor:rawstor /var/lib/rawstor
if [ $1 -eq 1 ]; then
    systemctl enable rawstor-ost.service >/dev/null 2>&1 || :
    systemctl start rawstor-ost.service >/dev/null 2>&1 || :
fi

%preun -n rawstor-ost
if [ $1 -eq 0 ]; then
    systemctl stop rawstor-ost.service >/dev/null 2>&1 || :
    systemctl disable rawstor-ost.service >/dev/null 2>&1 || :
fi

%postun -n rawstor-ost
if [ $1 -ge 1 ]; then
    systemctl try-restart rawstor-ost.service >/dev/null 2>&1 || :
fi

%files
%{_bindir}/rawstor-cli
%{_libdir}/librawstor.so.*
%doc COPYING ChangeLog.md README.md

%files devel
%{_includedir}/*
%{_libdir}/librawstor.so
%{_libdir}/pkgconfig/*.pc

%files -n rawstor-ost
%{_bindir}/rawstor-ost
%{_unitdir}/rawstor-ost.service
%dir %attr(0755, rawstor, rawstor) /var/lib/rawstor

%files -n python%{python3_pkgversion}-rawstor
%{python3_sitelib}/rawstor
%{python3_sitelib}/rawstor-*.dist-info
