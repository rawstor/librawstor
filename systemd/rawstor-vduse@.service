[Unit]
Description=Rawstor VDUSE virtio-blk backend for object %i
After=network-online.target rawstor-ost.service
Wants=network-online.target
# The vduse kernel module (modprobe vduse) is a manual, one-time host setup
# step -- see the top-level README's "rawstor-vduse" section -- not
# something this unit loads itself. Skip (rather than crash-loop) if it
# hasn't been loaded yet.
ConditionPathExists=/dev/vduse/control

[Service]
Type=simple
# User=/Group= (and any other directive here) is a *systemd unit* setting,
# not something EnvironmentFile= below can touch -- EnvironmentFile= only
# feeds environment variables to the process, it cannot change unit
# directives. To run under a different user/group, add a drop-in instead of
# editing this file:
#   systemctl edit rawstor-vduse@.service            # applies to every instance
#   systemctl edit rawstor-vduse@<uuid>.service       # applies to just <uuid>
# then put e.g.
#   [Service]
#   User=someone-else
#   Group=someone-else
# in the editor that opens; systemd stores it under
# /etc/systemd/system/rawstor-vduse@.service.d/override.conf (or the
# per-instance equivalent) and layers it on top of this file, which
# package upgrades never touch. See systemd.unit(5), "Automatic
# manipulation of unit files". Whatever user/group you pick needs access to
# /dev/vduse/control -- see the udev rule this package installs
# (udev/60-rawstor-vduse.rules), which grants it to the "rawstor" group.
User=rawstor
Group=rawstor
# rawstor-vduse's own --num-queues/--write-cache (see its --help);
# override in /etc/rawstor-vduse.conf below rather than editing this
# file. One worker thread (and one connection to the backend) per
# virtqueue; raise NUM_QUEUES for guests with more vCPUs queuing on more
# virtio-blk queues, lower it to shrink the number of connections this
# instance opens to the backend target. write-through (off) makes every
# guest write durable on completion; writeback (on) is faster but relies
# on the guest issuing an explicit flush, and only helps if the guest
# actually does.
Environment=RAWSTOR_LOCATION=ost://127.0.0.1:7777
Environment=NUM_QUEUES=16
Environment=RAWSTOR_WRITE_CACHE=off
EnvironmentFile=-/etc/rawstor-vduse.conf
ExecStart=/usr/bin/rawstor-vduse --num-queues=${NUM_QUEUES} --write-cache=${RAWSTOR_WRITE_CACHE} ${RAWSTOR_LOCATION}/%i
Restart=always
RestartSec=2
# sysexits.h codes rawstor-vduse exits with when retrying won't help:
# EX_NOINPUT (66) the target object doesn't exist on any backend (removed
# out from under this instance) and EX_NOPERM (77) permission denied. Leave
# the unit failed instead of restart-looping; other exit codes (e.g.
# EX_UNAVAILABLE for a backend that's merely down right now) still retry.
RestartPreventExitStatus=66 77
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
