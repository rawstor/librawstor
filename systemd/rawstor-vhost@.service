[Unit]
Description=Rawstor vhost-user-blk backend for object %i
After=network-online.target rawstor-ost.service
Wants=network-online.target

[Service]
Type=simple
# User=/Group= (and any other directive here) is a *systemd unit* setting,
# not something EnvironmentFile= below can touch -- EnvironmentFile= only
# feeds environment variables to the process, it cannot change unit
# directives. To run under a different user/group (e.g. to match whatever
# user your qemu/libvirt setup actually uses instead of granting it access
# via the "rawstor" group), add a drop-in instead of editing this file:
#   systemctl edit rawstor-vhost@.service            # applies to every instance
#   systemctl edit rawstor-vhost@<uuid>.service       # applies to just <uuid>
# then put e.g.
#   [Service]
#   User=libvirt-qemu
#   Group=libvirt-qemu
# in the editor that opens; systemd stores it under
# /etc/systemd/system/rawstor-vhost@.service.d/override.conf (or the
# per-instance equivalent) and layers it on top of this file, which
# package upgrades never touch. See systemd.unit(5), "Automatic
# manipulation of unit files".
User=rawstor
Group=rawstor
RuntimeDirectory=rawstor
RuntimeDirectoryMode=0750
# rawstor-vhost doesn't chmod() the vhost-user socket after creating it, so
# its permissions come straight from bind(2) + this umask: 0777 & ~UMask.
# On Linux, connect(2) to a UNIX stream socket requires *write* permission
# on the socket file itself (see unix(7), "Pathname socket ownership and
# permissions") -- the default UMask=0022 would produce mode 0755, which
# gives QEMU's group membership read+execute but no write, i.e. it could
# never actually connect. 0007 yields 0770 (rw for owner and group, nothing
# for other), which is what makes "add the qemu user to the rawstor group"
# below actually work.
UMask=0007
Environment=RAWSTOR_LOCATION=ost://127.0.0.1:7777
EnvironmentFile=-/etc/rawstor-vhost.conf
ExecStart=/usr/bin/rawstor-vhost --socket-path=/run/rawstor/%i.sock ${RAWSTOR_LOCATION}/%i
Restart=always
RestartSec=2
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
