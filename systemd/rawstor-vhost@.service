[Unit]
Description=Rawstor vhost-user-blk backend for object %i
After=network-online.target rawstor-ost.service
Wants=network-online.target

[Service]
Type=simple
# User=/Group= (and any other directive here) is a *systemd unit* setting,
# not something EnvironmentFile= below can touch -- EnvironmentFile= only
# feeds environment variables to the process, it cannot change unit
# directives. To run under a different user/group (e.g. to match whatever
# user your qemu/libvirt setup actually uses instead of granting it access
# via the "rawstor" group), add a drop-in instead of editing this file:
#   systemctl edit rawstor-vhost@.service            # applies to every instance
#   systemctl edit rawstor-vhost@<uuid>.service       # applies to just <uuid>
# then put e.g.
#   [Service]
#   User=libvirt-qemu
#   Group=libvirt-qemu
# in the editor that opens; systemd stores it under
# /etc/systemd/system/rawstor-vhost@.service.d/override.conf (or the
# per-instance equivalent) and layers it on top of this file, which
# package upgrades never touch. See systemd.unit(5), "Automatic
# manipulation of unit files".
User=rawstor
Group=rawstor
RuntimeDirectory=rawstor
# rawstor-vhost chmod()s the vhost-user socket to 0660 itself right after
# creating it, so QEMU only needs to be in the "rawstor" group (see below)
# -- the directory itself is left at the systemd default (0755) so that
# unprivileged tools (health checks, `test -S`, monitoring) can still stat
# the socket path without being root or in the "rawstor" group; connect(2)
# is still blocked for them by the socket file's own 0660 mode.
Environment=LOCATION=ost://127.0.0.1:7777
# rawstor-vhost's own --num-queues/--write-cache (see its --help);
# override in /etc/rawstor-vhost.conf below rather than editing this
# file. One worker thread (and one connection to the backend) per
# virtqueue; raise NUM_QUEUES for guests with more vCPUs queuing on more
# virtio-blk queues, lower it to shrink the number of connections this
# instance opens to the backend target. write-through (WRITE_CACHE=off)
# makes every guest write durable on completion by forcing a journal
# commit per write -- fine on a host whose filesystem commits quickly,
# but observed to stall write RTTs into the tens of seconds under
# concurrent load on a host where the backing disk's journal commit is
# slow. writeback (on) avoids that per-write commit and instead relies
# on the guest issuing an explicit flush when it needs durability, same
# as any real disk with a volatile write cache; any modern guest kernel
# does this correctly.
Environment=NUM_QUEUES=16
Environment=WRITE_CACHE=on
# Retry a lost backend connection forever (rather than the library's own
# default of giving up after 3 attempts): a QEMU vhost-user chardev's own
# `reconnect=N` retries this same way, so this instance should outlast a
# backend blip the same way QEMU outlasts *this* instance restarting.
# "-1" parses as UINT_MAX via the usual unsigned env-var parsing (see
# README.md) -- not a literal "unlimited" sentinel, just a very large
# number of attempts.
Environment=RAWSTOR_OPTS_IO_WIRE_RETRY_ATTEMPTS=-1
# librawstor client/server tuning knobs (see README.md's "Environment
# Variables" section for what each one does); uncomment to override a
# default, or set them in /etc/rawstor-vhost.conf below instead.
#Environment=RAWSTOR_OPTS_IO_ATTEMPTS=3
#Environment=RAWSTOR_OPTS_IO_RETRY_BACKOFF_BASE=100
#Environment=RAWSTOR_OPTS_IO_RETRY_BACKOFF_MAX=2000
#Environment=RAWSTOR_OPTS_IO_RETRY_BACKOFF_JITTER=50
#Environment=RAWSTOR_OPTS_SESSIONS=1
#Environment=RAWSTOR_OPTS_SO_SNDTIMEO=5000
#Environment=RAWSTOR_OPTS_SO_RCVTIMEO=5000
#Environment=RAWSTOR_OPTS_TCP_USER_TIMEOUT=5000
#Environment=RAWSTOR_OPTS_LIST_LIMIT=1000
#Environment=RAWSTOR_OPTS_WRITE_THROTTLE_LIMIT=128
#Environment=RAWSTOR_OPTS_WRITE_BACKLOG_CAPACITY=256M
EnvironmentFile=-/etc/rawstor-vhost.conf
ExecStart=/usr/bin/rawstor-vhost --socket-path=/run/rawstor/%i.sock --num-queues=${NUM_QUEUES} --write-cache=${WRITE_CACHE} ${LOCATION}/%i
Restart=always
RestartSec=2
# sysexits.h codes rawstor-vhost exits with when retrying won't help:
# EX_NOINPUT (66) the target object doesn't exist on any backend (removed
# out from under this instance) and EX_NOPERM (77) permission denied. Leave
# the unit failed instead of restart-looping; other exit codes (e.g.
# EX_UNAVAILABLE for a backend that's merely down right now) still retry.
RestartPreventExitStatus=66 77
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
