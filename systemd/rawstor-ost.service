[Unit]
Description=Rawstor OST backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rawstor
Group=rawstor
WorkingDirectory=/var/lib/rawstor
StateDirectory=rawstor
Environment=BIND_ADDR=0.0.0.0:7777
# rawstor-ost's own --queue-size/--write-throttle-limit (see its --help);
# override in /etc/rawstor-ost.conf below rather than editing this file.
Environment=QUEUE_SIZE=4096
Environment=WRITE_THROTTLE_LIMIT=128
# librawstor client/server tuning knobs (see README.md's "Environment
# Variables" section for what each one does); uncomment to override a
# default, or set them in /etc/rawstor-ost.conf below instead.
#Environment=RAWSTOR_OPTS_IO_ATTEMPTS=3
#Environment=RAWSTOR_OPTS_SESSIONS=1
#Environment=RAWSTOR_OPTS_SO_SNDTIMEO=5000
#Environment=RAWSTOR_OPTS_SO_RCVTIMEO=5000
#Environment=RAWSTOR_OPTS_TCP_USER_TIMEOUT=5000
#Environment=RAWSTOR_OPTS_LIST_LIMIT=1000
EnvironmentFile=-/etc/rawstor-ost.conf
ExecStart=/usr/bin/rawstor-ost --bind=${BIND_ADDR} --queue-size=${QUEUE_SIZE} --write-throttle-limit=${WRITE_THROTTLE_LIMIT} file:///var/lib/rawstor
Restart=always
RestartSec=10
# sysexits.h codes rawstor-ost exits with when retrying won't help:
# EX_NOINPUT (66) the configured location doesn't exist and EX_NOPERM (77)
# permission denied. Leave the unit failed instead of restart-looping;
# other exit codes (e.g. EX_UNAVAILABLE for an upstream ost:// backend
# that's merely down right now) still retry.
RestartPreventExitStatus=66 77
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
