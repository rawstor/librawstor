#!/bin/sh
set -e

# Package removal stops the running instances; their configs
# (/etc/rawstor/mds), data (/var/lib/rawstor-mds) and enablement are left
# alone, so reinstalling the package brings them back as they were.
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl stop 'rawstor-mds@*.service' || true
fi

#DEBHELPER#

exit 0
