#!/bin/sh
set -e

case "$1" in
    configure)
        if ! getent group rawstor >/dev/null; then
            addgroup --system rawstor
        fi
        if ! getent passwd rawstor >/dev/null; then
            adduser --system --no-create-home --ingroup rawstor --home /var/lib/rawstor --shell /usr/sbin/nologin rawstor
        fi
        # Instance configs (/etc/rawstor/ost/<uuid>.conf) are written by the
        # admin; nothing is started here -- an instance runs only once it
        # is configured and enabled (README.md).
        mkdir -p /etc/rawstor/ost

        # Upgrade: restart the instances that are running, so they pick up
        # the new binary; stopped ones stay stopped.
        if [ -n "$2" ] && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl try-restart 'rawstor-ost@*.service' || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
