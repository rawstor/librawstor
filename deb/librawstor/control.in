Source: @PACKAGE_NAME@
Section: libs
Priority: optional
Maintainer: @MAINTAINER@
Build-Depends: debhelper (>= 12)
Standards-Version: 4.7.0

Package: @PACKAGE_NAME@
Architecture: any
Depends: ${misc:Depends},
         ${shlibs:Depends},
         liburing2 (>= @LIBURING_MIN_VERSION@),
         libxxhash0
Description: Rawstor client library and command line tools
Homepage: https://github.com/rawstor/librawstor

Package: @PACKAGE_NAME@-dev
Architecture: any
Depends: ${misc:Depends},
         ${shlibs:Depends},
         @PACKAGE_NAME@ (= ${binary:Version}),
         pkg-config
Description: Development files for @PACKAGE_NAME@
Homepage: https://github.com/rawstor/librawstor

Package: rawstor-ost
Architecture: any
Depends: ${misc:Depends},
         ${shlibs:Depends},
         adduser,
         @PACKAGE_NAME@ (= ${binary:Version})
Description: Rawstor OST backend
Homepage: https://github.com/rawstor/librawstor

Package: rawstor-vhost
Architecture: any
Depends: ${misc:Depends},
         ${shlibs:Depends},
         adduser,
         @PACKAGE_NAME@ (= ${binary:Version})
Description: Rawstor vhost-user-blk backend for QEMU
Homepage: https://github.com/rawstor/librawstor

Package: rawstor-vduse
Architecture: any
Depends: ${misc:Depends},
         ${shlibs:Depends},
         adduser,
         @PACKAGE_NAME@ (= ${binary:Version})
Description: Rawstor VDUSE virtio-blk backend
Homepage: https://github.com/rawstor/librawstor
